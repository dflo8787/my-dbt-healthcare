with h as (select * from `li_ws`.`silver_staging_silver_staging`.`stg_hospital_master`), e as (select * from `li_ws`.`silver_staging_silver_staging`.`stg_encounters`), o as (select * from `li_ws`.`silver_staging_silver_staging`.`stg_patient_outcomes`),
m as (select h.hospital_id, avg(o.readmission_rate) as arr from h left join e on h.hospital_id=e.hospital_id left join o on h.hospital_id=o.hospital_id group by h.hospital_id)
select case when arr<0.2 then 'A' when arr<0.35 then 'B' when arr<0.5 then 'C' else 'D' end as quality_tier, count(*) as n from m group by 1 order by 1
  
  limit 20

