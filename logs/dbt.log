insert into li_ws.second_brain.architecture_decisions
(decision_id, decision_date, decision_title, context, options_considered, rationale, outcome, owner, linked_files, recorded_at) values
('ADR-run7-001','2026-06-03','Materialize approved Gold directly from PR #7 branch (no separate Gold PR)','Run 7 Gold code (gold_member_risk_summary) lived on the open Silver PR #7 branch, not on master. Human reviewed Phase 9 approval context and chose APPROVE.','1) Open a separate Gold PR; 2) Self-merge PR #7 then materialize from master; 3) Materialize directly from the existing PR #7 branch.','Human explicitly directed no separate Gold PR since Gold code is already in PR #7 branch. Self-merging PRs is a human/git-agent responsibility. Building from the feature branch honors the approval without the orchestrator performing a merge.','Gold materialized from feature branch: 49 rows, 9 tests PASS, PII-free confirmed. PR #7 left OPEN for human to merge to persist code on master.','orchestrator','models/gold/gold_member_risk_summary.sql; models/staging/stg_member_enrollment.sql; macros/mask_pii.sql', current_timestamp()),
('ADR-run7-002','2026-06-03','Retain doubled-name schema convention (silver_staging_silver_staging / silver_staging_gold)','Project profile schema is silver_staging; dbt schema config appends, producing silver_staging_silver_staging for Silver and silver_staging_gold for Gold.','1) Rename schemas to clean names; 2) Relocate tables; 3) Leave as-is.','Human explicitly instructed to leave schema naming as-is; this is an accepted project-wide convention. Changing it would break existing live tables and downstream references.','No schema config changes; no table relocation. Tables remain where prior runs placed them.','human','dbt_project.yml; profiles.yml', current_timestamp())

  
