with e as (select * from `li_ws`.`silver_staging_silver_staging`.`stg_encounters`), p as (select * from `li_ws`.`silver_staging_silver_staging`.`stg_providers`),
m as (select e.provider_id, avg(e.length_of_stay_days) as los from e inner join p on e.provider_id=p.provider_id group by e.provider_id)
select case when los<=3 then 'EXCELLENT' when los<=6 then 'GOOD' else 'NEEDS_REVIEW' end as performance_tier, count(*) as n from m group by 1 order by 1
  
  limit 20

