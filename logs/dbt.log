with outcomes as (select * from `li_ws`.`silver_staging_silver_staging`.`stg_patient_outcomes`),
patients as (select * from `li_ws`.`silver_staging_silver_staging`.`stg_patients`),
final as (
  select case when o.readmission_rate >= 0.7 then 'HIGH' when o.readmission_rate >= 0.3 then 'MEDIUM' else 'LOW' end as risk_tier
  from outcomes o left join patients p on o.patient_id = p.patient_id
)
select risk_tier, count(*) as n from final group by risk_tier order by risk_tier
  
  limit 20

